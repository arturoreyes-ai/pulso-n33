# Base de donde el tablero lee los JSON. Sin definir = /data (mismo origen,
# copiado al build por scripts/sincronizar-datos.mjs).
#
# OJO: NEXT_PUBLIC_* se INCRUSTA en el bundle del cliente al construir, no se
# lee en tiempo de ejecucion. Cambiar de host es una variable MAS un redespliegue.
# Y por eso mismo aqui no puede ir un token: seria publico.
# NEXT_PUBLIC_DATOS_URL=https://ejemplo.mx/datos
