# Base de donde el tablero lee los JSON. Sin definir = /data (mismo origen,
# copiado al build por scripts/sincronizar-datos.mjs).
#
# OJO: NEXT_PUBLIC_* se INCRUSTA en el bundle del cliente al construir, no se
# lee en tiempo de ejecucion. Cambiar de host es una variable MAS un redespliegue.
# Y por eso mismo aqui no puede ir un token: seria publico.
# NEXT_PUBLIC_DATOS_URL=https://ejemplo.mx/datos

# ------------------------------------------------------------- acceso
# El tablero es privado: entra quien tenga cuenta de Microsoft en el
# inquilino, y el rol lo pone la tabla `usuarios` (Neon). Receta completa,
# registro en Azure incluido, en docs/acceso.md. En Vercel estas variables
# se definen en el proyecto y `vercel pull` las baja al runner del cron.

# Secreto con el que Auth.js firma la cookie de sesion. No viene de Azure y
# Auth.js lo lee solo: ningun modulo nuestro lo toca. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Azure > Registros de aplicaciones > la app > Informacion general >
# "Id. de aplicacion (cliente)".
AUTH_MICROSOFT_ENTRA_ID_ID=
# Azure > Certificados y secretos > Secretos de cliente > columna "Valor".
# NO el "Id. de secreto": ese pega igual de bien y falla con AADSTS7000215.
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<Id. de directorio (inquilino)>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Correo que entra como admin en CADA entrada, no solo la primera: es el
# arranque de la tabla vacia y la puerta de emergencia si el ultimo admin se
# pierde. En minusculas.
ACCESO_PRIMER_ADMIN=

# Postgres de Neon (nivel gratuito). La integracion de Vercel Marketplace la
# exporta al proyecto como NEON_DB_DATABASE_URL (con prefijo), y el codigo
# acepta los dos nombres; en local se copia del panel de Neon o de la pestana
# de la integracion. `pnpm migrar` crea la tabla.
DATABASE_URL=postgresql://<usuario>:<password>@<host>.neon.tech/neondb?sslmode=require

# Solo `next dev`: entra sin Azure ni sesion como ACCESO_DEV_CORREO con rol
# ACCESO_DEV_ROL (lector o admin; por omision admin). Se ignora con
# NODE_ENV=production, o sea en todo build y en Vercel. Sin DATABASE_URL, el
# usuario de desarrollo es sintetico y la tabla no se toca.
# ACCESO_SIN_ENTRA=true
# ACCESO_DEV_CORREO=dev@pulso.local
# ACCESO_DEV_ROL=admin
